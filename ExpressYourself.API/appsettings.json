{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=ExpressYourself;Integrated Security=true;TrustServerCertificate=true;",
    "Redis": ""
  },
  "Ip2c": {
    "BaseUrl": "https://ip2c.org/",
    "TimeoutSeconds": 5,
    "RetryCount": 3,
    "CircuitBreakerFailureCount": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultTtlMinutes": 60,
    "NegativeTtlSeconds": 60
  },
  "RateLimiting": {
    "IpLookup": {
      "PermitLimit": 10,
      "WindowSeconds": 10
    },
    "CountryReport": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    }
  },
  "RefreshJob": {
    "Enabled": true,
    "CronExpression": "0 0 * * * ?",
    "BatchSize": 100,
    "MaxConcurrency": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}